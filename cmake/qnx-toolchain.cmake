# CMake toolchain file for QNX SDP 8.0 (qcc / GCC 12.2)
# Usage: cmake -DCMAKE_TOOLCHAIN_FILE=cmake/qnx-toolchain.cmake -DQNX_ARCH=x86_64|aarch64le ...
# Requires: source $QNX_SDP/qnxsdp-env.sh  (sets QNX_HOST / QNX_TARGET)
set(CMAKE_SYSTEM_NAME QNX)
set(CMAKE_SYSTEM_VERSION 8.0.0)

if(NOT QNX_ARCH)
  set(QNX_ARCH "$ENV{QNX_ARCH}")
endif()
if(NOT QNX_ARCH)
  set(QNX_ARCH x86_64)
endif()
set(QNX_ARCH "${QNX_ARCH}" CACHE STRING "QNX target arch (x86_64 or aarch64le)")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES QNX_ARCH)

if(QNX_ARCH STREQUAL "x86_64")
  set(CMAKE_SYSTEM_PROCESSOR x86_64)
  set(_qnx_v gcc_ntox86_64)
elseif(QNX_ARCH STREQUAL "aarch64le")
  set(CMAKE_SYSTEM_PROCESSOR aarch64)
  set(_qnx_v gcc_ntoaarch64le)
else()
  message(FATAL_ERROR "Unsupported QNX_ARCH=${QNX_ARCH}")
endif()

set(QNX_HOST   "$ENV{QNX_HOST}")
set(QNX_TARGET "$ENV{QNX_TARGET}")
if(NOT QNX_HOST OR NOT QNX_TARGET)
  message(FATAL_ERROR "QNX_HOST/QNX_TARGET not set: source qnxsdp-env.sh first")
endif()

set(CMAKE_C_COMPILER   "${QNX_HOST}/usr/bin/qcc")
set(CMAKE_CXX_COMPILER "${QNX_HOST}/usr/bin/q++")
set(CMAKE_C_COMPILER_TARGET   ${_qnx_v})
set(CMAKE_CXX_COMPILER_TARGET ${_qnx_v}_cxx)

set(CMAKE_SYSROOT_COMPILE "")
set(CMAKE_FIND_ROOT_PATH "${QNX_TARGET}" "${QNX_TARGET}/${QNX_ARCH}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
