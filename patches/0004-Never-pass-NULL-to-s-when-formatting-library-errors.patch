From 4259f514f65b17884a02520d4cce2cea533d8959 Mon Sep 17 00:00:00 2001
From: nats-qnx <nats-qnx@localhost>
Date: Sat, 21 Nov 2026 03:28:49 +0700
Subject: [PATCH] Never pass NULL to "%s" when formatting library errors

Passing NULL for a "%s" conversion is undefined behavior. glibc prints
"(null)" so this is invisible on Linux, but on QNX (and other libcs) the
process crashes with SIGSEGV inside nats_setError(), i.e. a recoverable
error turns into a crash of the application.

Found by running the upstream test-suite on QNX 8.0:

* NATS_SSL_ERR_REASON_STRING expanded to
  ERR_reason_error_string(ERR_get_error()), which returns NULL when the
  OpenSSL error queue is empty and, with OpenSSL 3, for system (errno)
  errors. E.g. natsOptions_SetCATrustedCertificates(opts, "invalid"),
  natsOptions_LoadCATrustedCertificates() on a missing file, or a TLS
  handshake aborted by the peer all crashed. It now goes through
  nats_sslErrReasonString(), which never returns NULL.

* js_directGetMsgToJSMsg() printed the (possibly NULL) header value in
  its "missing stream name/sequence/timestamp/subject" errors, so a
  malformed direct-get reply crashed the client. Use NATS_SAFE_STR().

Tests fixed on QNX: SSLLoadCAFromMemory, SSLServerNameIndication,
SSLTLSSettingsImplySecure, JetStreamConvertDirectMsg.
---
 src/err.h   | 10 +++++++++-
 src/jsm.c   | 10 +++++-----
 src/natsp.h | 13 +++++++++++++
 3 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/src/err.h b/src/err.h
index 033539e..ea99bba 100644
--- a/src/err.h
+++ b/src/err.h
@@ -24,7 +24,15 @@
 #include "status.h"
 #include "nats.h"
 
-#define NATS_SSL_ERR_REASON_STRING ERR_reason_error_string(ERR_get_error())
+// ERR_reason_error_string() returns NULL when the error queue is empty and,
+// with OpenSSL 3, for system (errno) errors. That NULL ends up as the
+// argument of a "%s" conversion, which is undefined behavior: glibc prints
+// "(null)" but QNX's libc crashes. nats_sslErrReasonString() never
+// returns NULL (see natsp.h).
+#define NATS_SSL_ERR_REASON_STRING nats_sslErrReasonString()
+
+// Never pass a possibly-NULL string to a "%s" conversion (see above).
+#define NATS_SAFE_STR(s) (((s) != NULL) ? (s) : "")
 
 #define nats_setDefaultError(e) nats_setError((e), "%s", natsStatus_GetText(e))
 
diff --git a/src/jsm.c b/src/jsm.c
index a0ce725..35c1993 100644
--- a/src/jsm.c
+++ b/src/jsm.c
@@ -2292,30 +2292,30 @@ js_directGetMsgToJSMsg(natsMsg *msg)
         else
         {
             natsMsgHeader_Get(msg, DESCRIPTION_HDR, &val);
-            return nats_setError(NATS_ERR, "error getting message: %s", val);
+            return nats_setError(NATS_ERR, "error getting message: %s", NATS_SAFE_STR(val));
         }
     }
 
     s = natsMsgHeader_Get(msg, JSStream, &val);
     if ((s != NATS_OK) || nats_IsStringEmpty(val))
-        return nats_setError(NATS_ERR, "missing stream name '%s'", val);
+        return nats_setError(NATS_ERR, "missing stream name '%s'", NATS_SAFE_STR(val));
 
     val = NULL;
     s = natsMsgHeader_Get(msg, JSSequence, &val);
     if ((s != NATS_OK) || ((seq = nats_ParseInt64(val, (int) strlen(val))) == -1))
-        return nats_setError(NATS_ERR, "missing or invalid sequence '%s'", val);
+        return nats_setError(NATS_ERR, "missing or invalid sequence '%s'", NATS_SAFE_STR(val));
 
     val = NULL;
     s = natsMsgHeader_Get(msg, JSTimeStamp, &val);
     if ((s == NATS_OK) && !nats_IsStringEmpty(val))
         s = nats_parseTime((char*) val, &tm);
     if ((s != NATS_OK) || (tm == 0))
-        return nats_setError(NATS_ERR, "missing or invalid timestamp '%s'", val);
+        return nats_setError(NATS_ERR, "missing or invalid timestamp '%s'", NATS_SAFE_STR(val));
 
     val = NULL;
     s = natsMsgHeader_Get(msg, JSSubject, &val);
     if ((s != NATS_OK) || nats_IsStringEmpty(val))
-        return nats_setError(NATS_ERR, "missing or invalid subject '%s'", val);
+        return nats_setError(NATS_ERR, "missing or invalid subject '%s'", NATS_SAFE_STR(val));
 
     // Will point the message subject to the JSSubject header value.
     // This will remain in the message memory allocated block, even
diff --git a/src/natsp.h b/src/natsp.h
index eed404c..5172682 100644
--- a/src/natsp.h
+++ b/src/natsp.h
@@ -28,6 +28,19 @@
 #include <openssl/evp.h>
 #define nats_hash           EVP_MD_CTX
 #define NATS_HASH_MAX_LEN   EVP_MAX_MD_SIZE
+
+// Like ERR_reason_error_string(ERR_get_error()) but never returns NULL
+// (used through NATS_SSL_ERR_REASON_STRING, see err.h).
+static inline const char*
+nats_sslErrReasonString(void)
+{
+    unsigned long   e = ERR_get_error();
+    const char      *r = ERR_reason_error_string(e);
+
+    if (r != NULL)
+        return r;
+    return ((e == 0) ? "unknown error" : "unknown OpenSSL error");
+}
 #else
 #define SSL                 void*
 #define SSL_free(c)         { (c) = NULL; }
